# Copia este archivo como .env (no se sube al repositorio)
# Por defecto funciona sin instalar MySQL. Usa DB_ENGINE=mysql para Laragon.
DB_ENGINE=sqlite
DB_NAME=tallerexpress
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=clave-solo-local-no-usar-en-produccion
